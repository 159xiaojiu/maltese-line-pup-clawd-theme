{
  "schemaVersion": 1,
  "name": "线条小狗 · 小白",
  "author": "159xiaojiu",
  "version": "3.4.2",
  "description": "线条小狗 Maltese 多形态桌宠主题：透明底动图（白底色键抠图），适配 Clawd on Desk + Cursor Agent 状态联动",
  "license": "Personal use only. Sticker assets © Moonlab Studio (MALTESE).",

  "viewBox": { "x": 0, "y": 0, "width": 240, "height": 240 },
  "layout": {
    "contentBox": { "x": 20, "y": 20, "width": 200, "height": 200 },
    "centerX": 120,
    "baselineY": 210,
    "visibleHeightRatio": 0.55,
    "baselineBottomRatio": 0.05
  },

  "eyeTracking": { "enabled": false },

  "states": {
    "idle": [
      "maltese-idle-on-golden.gif",
      "maltese-idle-breathe.gif",
      "maltese-idle-shiver.gif"
    ],
    "thinking": [
      "maltese-thinking-shock.gif",
      "maltese-thinking-dazed.gif",
      "maltese-thinking-ellipsis.png"
    ],
    "working": [
      "maltese-working-duo.gif",
      "maltese-working-play.gif"
    ],
    "juggling": [
      "maltese-juggle-shock.gif",
      "maltese-juggle-play.gif"
    ],
    "error": [
      "maltese-error-sad.png",
      "maltese-sad-pout.png",
      "maltese-error-noway.png"
    ],
    "attention": [
      "maltese-happy-heart.gif",
      "maltese-happy-jump.gif",
      "maltese-happy-party.gif",
      "maltese-happy-flower.gif",
      "maltese-happy-sparkle.png",
      "maltese-happy-dance.png",
      "maltese-happy-tongue.png",
      "maltese-happy-party2.gif",
      "maltese-happy-heart2.gif",
      "maltese-happy-thumbs.png",
      "maltese-happy-flower-petal.gif",
      "maltese-happy-flower-head.png",
      "maltese-happy-peek.png",
      "maltese-happy-picnic.png",
      "maltese-happy-bee.png"
    ],
    "notification": [
      "maltese-notify-alert.gif"
    ],
    "sleeping": ["maltese-sleep-breathe.gif"],
    "waking": ["maltese-wake-wave.gif"]
  },

  "sleepSequence": { "mode": "direct" },

  "workingTiers": [
    { "minSessions": 3, "file": "maltese-working-busy.gif" },
    { "minSessions": 2, "file": "maltese-working-play.gif" },
    { "minSessions": 1, "file": "maltese-working-duo.gif" }
  ],

  "jugglingTiers": [
    { "minSessions": 2, "file": "maltese-juggle-shock.gif" },
    { "minSessions": 1, "file": "maltese-juggle-play.gif" }
  ],

  "idleAnimations": [
    { "file": "maltese-idle-heart.gif", "duration": 4800 },
    { "file": "maltese-idle-peek.png", "duration": 6000 },
    { "file": "maltese-happy-peek.png", "duration": 5500 },
    { "file": "maltese-happy-cheer.gif", "duration": 4500 },
    { "file": "maltese-happy-thumbs.png", "duration": 4000 }
  ],

  "timings": {
    "idleRotateInterval": 30000,
    "activityTriggersIdle": true,
    "activityDebounceMs": 600,
    "foregroundAppHud": true,
    "foregroundAppPollMs": 2000,
    "mouseIdleTimeout": 15000,
    "mouseSleepTimeout": 60000,
    "minDisplay": {
      "attention": 4500,
      "error": 4000,
      "notification": 5000,
      "working": 1000,
      "thinking": 1000
    },
    "autoReturn": {
      "attention": 4500,
      "error": 4000,
      "notification": 5000
    }
  },

  "hitBoxes": {
    "default": { "x": 20, "y": 10, "w": 200, "h": 210 },
    "sleeping": { "x": 15, "y": 60, "w": 210, "h": 160 }
  },

  "reactions": {
    "singleClick": true,
    "double": {
      "files": [
        "maltese-happy-party2.gif",
        "maltese-happy-heart2.gif",
        "maltese-happy-cheer.gif",
        "maltese-happy-picnic.png"
      ],
      "duration": 3000
    },
    "clickLeft": { "file": "maltese-happy-sparkle.png", "duration": 2500 },
    "clickRight": { "file": "maltese-happy-tongue.png", "duration": 2500 }
  },

  "miniMode": { "supported": false },

  "objectScale": {
    "widthRatio": 0.75,
    "heightRatio": 0.75,
    "offsetX": 0.12,
    "offsetY": 0.1
  }
}
